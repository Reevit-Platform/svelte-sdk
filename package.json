{
  "name": "@reevit/svelte",
  "version": "0.14.0",
  "description": "Reevit Svelte Payment Checkout SDK — Unified payment orchestration for Africa (Paystack, Hubtel, Flutterwave, M-Pesa, Moolre, Monnify, PawaPay, Stripe)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/svelte.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "postbuild": "cp dist/svelte.css dist/styles.css",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:package": "npm run build && node scripts/check-packed-package.mjs",
    "preview": "vite --config preview/vite.config.ts"
  },
  "keywords": [
    "reevit",
    "payment-orchestration",
    "payments",
    "africa",
    "ghana",
    "nigeria",
    "kenya",
    "mobile-money",
    "svelte",
    "sveltekit",
    "paystack",
    "hubtel",
    "flutterwave",
    "mpesa",
    "moolre",
    "monnify",
    "pawapay",
    "stripe"
  ],
  "author": "Reevit <support@reevit.io> (https://reevit.io)",
  "license": "MIT",
  "homepage": "https://reevit.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/Reevit-Platform/svelte-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Reevit-Platform/svelte-sdk/issues"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@reevit/core": "^0.9.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^20.0.0",
    "jsdom": "^30.0.1",
    "svelte": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11"
  }
}
